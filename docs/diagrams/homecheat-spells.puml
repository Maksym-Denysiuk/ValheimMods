@startuml homecheat-spells
' The spells feature DLL (HomeCheat.Features.Spells). Checked against src/Features/Spells on 2026-10-25 (spell file v4, ValheimMods ffa0986).
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
left to right direction

abstract class CommandBase <<core>>
class PatchSet <<core>>
class "Kit.Notify" as Notify <<core, static>>
class HomeApi <<core, static>> {
  +Exec(form) : string
}
interface IRadialConfig <<game, Valheim.UI>>

class SpellsCommand <<sealed>> {
  -settings : SpellsSettings
  #OnLoad()
  #OnUnload()
  #Execute(a) : string
  -Bar() : SpellBar
}
class SpellsSettings <<internal sealed>> {
  +{static} Current : SpellsSettings
  +Enabled : bool
  +Placeholder : bool
  +ConsumedFrame : int
  +Bar : SpellBar
  +Patches : PatchSet
  +Patched : bool
  +{static} On : bool
  +{static} ActiveBar : SpellBar
  +{static} ActiveFile : string
  +{static} TurnOff()
  +Load()
  +Save()
}
class SpellBar <<MonoBehaviour>> {
  -file : SpellFile
  ~Root() : SpellRootConfig
  ~MakeNodeElement(node, owner, radial)
  ~MakeLeaf(spell, owner, radial, icon, sub)
  ~MakeNote(label, sub, owner, radial)
  ~OpenLevel(radial, cfg, back)
  ~CastChain(chain)
  +LoadFile(report) : string
  +OpenRadial() : string
  +Status() : string
  -Update()
  -OnGUI()
  -CastSpell(s, shift, pinKey, answers)
  -{static} Exec(form) : string
}
class SpellFile <<internal sealed>> {
  +Pins : Dictionary<string,Spell>
  +Root : SpellNode
  +NodeAt(id) : SpellNode
  +Load(report) : string
  +SaveOverrides()
  +ResetPins() : string
  +ResetFile() : string
  +List() : string
  +SetPin(key, spellId) : string
  +FindSpell(id) : Spell
  +{static} DefaultText, TestText
}
class SpellParse <<internal sealed, no Unity>> {
  +Root : SpellNode
  +Spells, Pins : Dictionary<string,Spell>
  +Bad : List<string>
  +{static} Run(text) : SpellParse
  +{static} ParseId(id) : int[]
  +{static} ParseAsk(body, out err) : SpellAsk
  +{static} Substitute(form, answers) : string
  +{static} Split(options, max)
  +Find(id) : SpellNode
}
class SpellNode <<internal sealed>> {
  +Id, Title : string
  +Number : int
  +Sticky : bool
  +Spell : Spell
  +Children : List<SpellNode>
}
class Spell <<internal sealed>> {
  +Id : string
  +Top : int
  +Label, Cmd, Shift, Pin : string
  +Sticky : bool
  +Asks : List<SpellAsk>
}
class SpellAsk <<internal sealed>> {
  +Key, Source : string
  +Options : List<SpellAskOption>
}
class SpellAskOption <<internal sealed>> {
  +Label, Value, Group : string
}
class SpellAskChain <<internal sealed>> {
  +Spell : Spell
  +Shift : bool
  +PinKey : string
  +Answers : Dictionary<string,string>
}
class SpellAskSources <<internal static, read only>> {
  +Resolve(ask) : List<SpellAskOption>
}
class SpellPatches <<public static>> {
  +OpenPrefix(ref config) : bool
  +HotbarPrefix(index) : bool
  ~EnsureApplied()
  ~Apply(on) : string
  ~OpenVanilla(radial)
}
class SpellRootConfig <<internal sealed>>
class SpellHotbarConfig <<internal sealed>>
class SpellGroupConfig <<internal sealed>>
class SpellLeafConfig <<internal sealed>>
class SpellPanelsConfig <<internal sealed>>
class SpellForm <<internal sealed>> {
  +{static} Current : SpellForm
  one screen for every ask= question
}

CommandBase <|-- SpellsCommand
SpellsCommand *-- SpellsSettings : new in OnLoad
SpellsCommand *-- SpellBar : Own(GameObject HomeCheat_SpellBar)
SpellsSettings --> SpellBar : Bar
SpellsSettings --> PatchSet : the command's Patches
SpellBar *-- SpellFile
SpellFile ..> SpellParse : Load -> Run(text)
SpellParse *-- SpellNode : Root
SpellNode o-- "0..*" SpellNode : Children
SpellNode o-- "0..1" Spell
Spell *-- "0..*" SpellAsk : ask= flags
SpellAsk *-- "0..*" SpellAskOption
SpellForm ..> SpellAskSources : dynamic answers, icons
SpellForm --> SpellAskChain : answers on Cast
SpellAskChain --> Spell
SpellBar ..> SpellAskChain : CastChain -> CastSpell
SpellBar ..> SpellParse : Substitute({key})
SpellBar ..> SpellPatches : Update -> EnsureApplied
SpellsCommand ..> SpellPatches : OnLoad -> EnsureApplied, enabled= -> Apply
SpellPatches ..> SpellsSettings : Current
SpellPatches ..> PatchSet : Patch(method, prefix, null)
SpellBar ..> HomeApi : Exec(form) per ";;" part
IRadialConfig <|.. SpellRootConfig
IRadialConfig <|.. SpellHotbarConfig
IRadialConfig <|.. SpellGroupConfig
IRadialConfig <|.. SpellLeafConfig
IRadialConfig <|.. SpellPanelsConfig
SpellBar ..> SpellRootConfig : Root()
SpellRootConfig ..> SpellPanelsConfig : Hotbar
SpellPanelsConfig ..> SpellHotbarConfig : Panel 1-5, Panel 6-0
SpellRootConfig ..> SpellGroupConfig
SpellBar ..> SpellLeafConfig
SpellBar ..> SpellForm : a spell with ask=
SpellBar ..> Notify : failures only
SpellGroupConfig ..> SpellGroupConfig : sub-section
@enduml
