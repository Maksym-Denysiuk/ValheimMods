@startuml homecheat-features
' HomeCheat feature DLLs: one package = one Features/<Feature> folder = one HomeCheat.Cmd.<feature>.v<stamp>.dll.
' 35 feature commands + 6 built-ins = 41. Checked against src/Features on 2026-10-25 (docs audit after the zone takeover, raven fall and Build > Ward changes).
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members
left to right direction

abstract class CommandBase <<core>>
abstract class AttackCommand <<core>>
abstract class HarmEffect <<core>>
class "Kit.Anchor" as KitAnchor <<core>>
CommandBase <|-- AttackCommand
AttackCommand <|-- HarmEffect

package "core built-ins  (HomeCheat.dll, HomeCheat.Builtins, internal sealed)" as core {
  class PingCommand
  class StatusCommand
  class ReloadCommand
  class CommandsCommand
  class HelpCommand
  class HarmEffectCommand
}
CommandBase <|-- PingCommand
CommandBase <|-- StatusCommand
CommandBase <|-- ReloadCommand
CommandBase <|-- CommandsCommand
CommandBase <|-- HelpCommand
CommandBase <|-- HarmEffectCommand
HarmEffectCommand ..> HarmEffect : kind=<name>

package "world  (HomeCheat.Features.WorldCommands)" as world {
  class GiveCommand
  class SpawnCommand
  class ListCommand
  class PlaceCommand
  class PlantCommand
  class FieldCommand
  class CultivateCommand
  class RepairCommand
  class RefillCommand
  class GroundLevelCommand
  class PathCommand
  class InspectCommand
  class ScaleCommand
  class CoordCommand
  class HarvestCommand
  class GrowRules <<internal static>>
  class FieldAnchor <<internal static>> {
    +AheadOfPlayer(p, a, spacing) : Anchor
  }
  class CropSpacing <<internal static>> {
    +Minimum(crop, out source) : float
  }
  class FieldPatch <<internal>> {
    +{static} Connected(soil, row, colFrom, colTo, out startSoil) : bool[,]
    +{static} Sample(at) : FieldPatch
    +Contains(pos) : bool
  }
  class TerrainOps <<internal static>> {
    +Prepare()
    +Vertex(x, z, y)
    +PaintTemplate(prefab, r, smooth) : string
    +Paint(template, pos)
    +RemoveLegacy(ax, az, bx, bz, avoid, keep, out kept) : int
    +Disc(c, r) : List<Vector2>
    +Box(ax, az, bx, bz) : List<Vector2>
    +Bounds(verts, pts, out x0, out z0, out x1, out z1) : bool
    +Claim(x0, z0, x1, z1, reach) : int
    +OwnersLine(x0, z0, x1, z1, reach) : string
    +Flatness(verts, target) : string
    +PaintedLike(pos, tool) : bool
  }
}

package "diag" as diag {
  class CheatStateCommand
  class CheatInfoCommand
}

package "heal" as heal {
  class HealCommand
  class CleanseCommand
  class BlessCommand
}

package "earthquake" as eq {
  class EarthquakeEffect
}
package "slime" as sl {
